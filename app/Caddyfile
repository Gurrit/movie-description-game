# SITE_ADDRESS defaults to plain HTTP on :80. Set it to a domain name and Caddy gets a certificate itself.
# BACKEND_ADDRESS is where the API runs.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Operational endpoint: reachable from inside the host only
	handle /api/internal/* {
		respond "Not found" 404
	}

	handle /api/* {
		reverse_proxy {$BACKEND_ADDRESS:backend:8080}
	}

	# The SPA: unknown paths (like /stats on reload) fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
